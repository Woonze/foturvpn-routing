{
  "region": "other",
  "block-ads": true,
  "use-xray-core-when-possible": false,
  "execute-config-as-is": false,
  "log-level": "warn",
  "resolve-destination": true,
  "ipv6-mode": "ipv4_only",
  "remote-dns-address": "8.8.8.8",
  "remote-dns-domain-strategy": "prefer_ipv4",
  "direct-dns-address": "77.88.8.8",
  "direct-dns-domain-strategy": "prefer_ipv4",
  "mixed-port": 12334,
  "tproxy-port": 12335,
  "direct-port": 12337,
  "redirect-port": 12336,
  "tun-implementation": "gvisor",
  "mtu": 9000,
  "strict-route": true,
  "connection-test-url": "http://captive.apple.com/hotspot-detect.html",
  "url-test-interval": 600,
  "enable-clash-api": true,
  "clash-api-port": 16756,
  "enable-tun": true,
  "enable-tun-service": false,
  "set-system-proxy": false,
  "bypass-lan": true,
  "allow-connection-from-lan": true,
  "enable-fake-dns": false,
  "independent-dns-cache": true,
  "route-rule": {
    "rules": [
      {
        "list_order": 0,
        "enabled": true,
        "name": "FoturVPN · реклама",
        "outbound": "block",
        "rule_set": [
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/category-ads.srs"
        ]
      },
      {
        "list_order": 1,
        "enabled": true,
        "name": "FoturVPN · телеметрия Windows",
        "outbound": "block",
        "rule_set": [
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/win-spy.srs"
        ]
      },
      {
        "list_order": 2,
        "enabled": true,
        "name": "FoturVPN · BitTorrent DHT",
        "outbound": "block",
        "rule_set": [
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/torrent.srs"
        ]
      },
      {
        "list_order": 10,
        "enabled": true,
        "name": "FoturVPN · через VPN",
        "outbound": "proxy",
        "rule_set": [
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/google-play.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/github.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/twitch-ads.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/youtube.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/telegram.srs"
        ]
      },
      {
        "list_order": 20,
        "enabled": true,
        "name": "FoturVPN · напрямую",
        "outbound": "direct",
        "rule_set": [
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/private.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/category-ru.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/whitelist.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/microsoft.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/apple.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/epicgames.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/riot.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/escapefromtarkov.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/steam.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/twitch.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/pinterest.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geosite/release/sing-box/faceit.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geoip/release/sing-box/private.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geoip/release/sing-box/direct.srs",
          "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geoip/release/sing-box/whitelist.srs"
        ]
      }
    ]
  },
  "mux": {
    "enable": false,
    "padding": false,
    "max-streams": 8,
    "protocol": "h2mux"
  },
  "tls-tricks": {
    "enable-fragment": true,
    "fragment-size": "10-30",
    "fragment-sleep": "2-8",
    "mixed-sni-case": true,
    "enable-padding": true,
    "padding-size": "1-1500"
  },
  "warp": {
    "enable": false,
    "mode": "warp_over_proxy",
    "wireguard-config": "",
    "license-key": "",
    "account-id": "",
    "access-token": "",
    "clean-ip": "auto",
    "clean-port": 0,
    "noise": "1-3",
    "noise-size": "10-30",
    "noise-delay": "10-30",
    "noise-mode": "m4"
  },
  "warp2": {
    "enable": false,
    "mode": "warp_over_proxy",
    "wireguard-config": "",
    "license-key": "",
    "account-id": "",
    "access-token": "",
    "clean-ip": "auto",
    "clean-port": 0,
    "noise": "1-3",
    "noise-size": "10-30",
    "noise-delay": "10-30",
    "noise-mode": "m4"
  }
}
